        "color": "$ink-dim",
        "size": 14
      }
    },
    ".small": {
      "text": {
        "color": "$ink-dim",
        "size": 13
      }
    },
    ".accent": {
      "text": {
        "color": "$accent",
        "weight": "700"
      }
    },
    ".legend": {
      "text": {
        "color": "$ink",
        "size": 16,
        "weight": "700"
      }
    },
    ".title-emblem": {
      "border": {
        "width": 2,
        "color": "$accent",
        "style": "solid"
      },
      "radius": 56,
      "shadow": {
        "y": 6,
        "blur": 24,
        "color": "#00000080"
      },
      "width": 112,
      "height": 112
    },
    ".btn": {
      "background": "#262c20d9",
      "border": {
        "width": 1,
        "color": "$line",
        "style": "solid"
      },
      "radius": "$radius",
      "padding": {
        "top": 8,
        "end": 18,
        "bottom": 8,
        "start": 18
      },
      "minWidth": 44,
      "minHeight": 44,
      "transition": [
        {
          "properties": "background",
          "duration": 0.15,
          "easing": "ease"
        },
        {
          "properties": "border",
          "duration": 0.15,
          "easing": "ease"
        }
      ],
      "text": {
        "color": "$ink",
        "size": 16,
        "align": "center"
      },
      "hovered": {
        "background": "#38402ee6",
        "border": {
          "color": "#f0e6c859"
        }
      },
      "pressed": {
        "background": "#46503af2"
      },
      "disabled": {
        "opacity": 0.45
      }
    },
    ".btn-primary": {
      "background": "$accent",
      "border": {
        "width": 1,
        "color": "#00000054",
        "style": "solid"
      },
      "text": {
        "color": "#241c08",
        "weight": "700"
      },
      "hovered": {
        "background": "#e5c45a"
      }
    },
    ".btn-danger": {
      "background": "#5a2320",
      "border": {
        "width": 1,
        "color": "#a04a3a",
        "style": "solid"
      }
    },
    ".btn-ghost": {
      "background": "#00000000",
      "hovered": {
        "background": "#38402e99"
      }
    },
    ".btn-dark": {
      "background": "#181c14bf"
    },
    ".btn-xl": {
      "padding": {
        "top": 12,
        "end": 22,
        "bottom": 12,
        "start": 22
      },
      "text": {
        "size": 18
      }
    },
    ".btn-small": {
      "padding": {
        "top": 4,
        "end": 10,
        "bottom": 4,
        "start": 10
      },
      "minHeight": 36,
      "text": {
        "size": 14
      }
    },
    ".mode-card": {
      "background": "$panel",
      "border": {
        "width": 1,
        "color": "$line",
        "style": "solid"
      },
      "radius": "$radius",
