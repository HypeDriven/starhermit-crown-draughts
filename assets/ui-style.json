          "blur": 24,
          "color": "#0000008c"
        }
      }
    },
    ".h2": {
      "text": {
        "color": "$ink",
        "size": 24,
        "font": "serif",
        "weight": "600"
      }
    },
    ".h3": {
      "text": {
        "color": "$accent",
        "size": 18,
        "font": "serif",
        "weight": "600"
      }
    },
    ".tagline": {
      "text": {
        "color": "$ink-dim",
        "size": 17
      }
    },
    ".note": {
      "text": {
        "color": "$ink-dim",
        "size": 13.6
      }
    },
    ".note-warn": {
      "text": {
        "color": "$warn",
        "size": 13.6
      }
    },
    ".text": {
